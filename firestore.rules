rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInWithGoogle() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // 프로필: 로그인한 사람은 읽기(랭킹), 본인만 처음 만들기와 닉네임 바꾸기.
    // 점수·전적은 서버(Cloud Functions)만 바꿀 수 있음.
    match /users/{uid} {
      allow read: if signedInWithGoogle();
      allow create: if signedInWithGoogle()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'score', 'wins', 'losses'])
        && request.resource.data.score == 1000
        && request.resource.data.wins == 0
        && request.resource.data.losses == 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 12;
      allow update: if signedInWithGoogle()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 12;
    }

    // 매칭 대기열: 서버 전용
    match /queue/{uid} {
      allow read, write: if false;
    }

    // 대전: 참가자만 읽기, 쓰기는 서버 전용
    match /games/{gameId} {
      allow read: if signedInWithGoogle()
        && (request.auth.uid == resource.data.catUid || request.auth.uid == resource.data.hamUid);
      allow write: if false;
    }
  }
}
