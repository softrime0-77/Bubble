rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 프로필: 누구나 읽기(랭킹), 본인만 쓰기
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == uid
        && request.resource.data.score == 1000
        && request.resource.data.wins == 0
        && request.resource.data.losses == 0;
      // 점수는 한 번에 +25 / -15 범위로만 바뀔 수 있음
      allow update: if request.auth.uid == uid
        && request.resource.data.score - resource.data.score <= 25
        && resource.data.score - request.resource.data.score <= 15;
    }

    // 매칭 대기열
    match /queue/{uid} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth.uid == uid;
      // 본인 또는 나를 매칭시키는 상대가 갱신
      allow update: if request.auth != null;
    }

    // 대전: 참가자만 읽고 쓰기
    match /games/{gameId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.catUid || request.auth.uid == resource.data.hamUid);
      allow create: if request.auth != null
        && (request.auth.uid == request.resource.data.catUid || request.auth.uid == request.resource.data.hamUid);
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.catUid || request.auth.uid == resource.data.hamUid)
        && request.resource.data.catUid == resource.data.catUid
        && request.resource.data.hamUid == resource.data.hamUid;
    }
  }
}
