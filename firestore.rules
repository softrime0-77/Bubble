rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 구글(안드로이드·아이폰) 또는 Apple(아이폰) 로그인
    function signedInWithGoogle() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'apple.com'];
    }

    // 프로필: 로그인한 사람은 읽기(랭킹), 본인은 닉네임만 바꿀 수 있음.
    // 점수·전적은 서버(Cloud Functions)만 바꿀 수 있음.
    match /users/{uid} {
      allow read: if signedInWithGoogle();
      // 프로필 생성은 서버(ensureProfile)만: 시작 점수(1000 / 재가입 0 / 관리자 5000)를 서버가 정함
      allow create: if false;
      // 닉네임도 서버(rename)만 바꿈: 첫 변경 무료, 그다음은 변경권 필요
      allow update: if false;
    }

    // 접속 신호: 본인 문서에 시각(at)만 쓸 수 있음. 읽기는 서버(관리자 통계)만.
    match /presence/{uid} {
      allow read: if false;
      allow write: if signedInWithGoogle()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at is int;
    }

    // 매칭 대기열: 서버 전용
    match /queue/{uid} {
      allow read, write: if false;
    }

    // 친구 대전방과 하루 판 수 기록: 서버 전용
    match /friendRooms/{code} {
      allow read, write: if false;
    }
    match /friendPairs/{id} {
      allow read, write: if false;
    }

    // 대전: 참가자만 읽기, 쓰기는 서버 전용
    match /games/{gameId} {
      allow read: if signedInWithGoogle()
        && (request.auth.uid == resource.data.catUid || request.auth.uid == resource.data.hamUid);
      allow write: if false;
    }
  }
}
